<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Jarvis_VisualPrototype.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="JARVIS Overlay"
    mc:Ignorable="d">
    <Grid Background="#F207121F">
        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
        <Grid x:Name="DragRegion" Background="#E90A1826" Padding="14,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Ellipse Width="8" Height="8" Fill="#38E7FF" />
                <TextBlock Foreground="#9EF5FF" FontFamily="Consolas" FontSize="11" CharacterSpacing="150" Text="JARVIS / LISTENING" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="26" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#8AA4B7" Click="Close_Click" Content="×" />
        </Grid>

        <Grid Grid.Row="1" Margin="16,8,16,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid Width="96" Height="96">
                <Ellipse x:Name="OuterRing" Stroke="#5538E7FF" StrokeThickness="1.5" StrokeDashArray="5,5" />
                <Ellipse Width="66" Height="66" Stroke="#BB38E7FF" StrokeThickness="2" StrokeDashArray="9,3" />
                <Ellipse x:Name="OverlayCore" Width="34" Height="34" Fill="#C6287CFF" Stroke="#38E7FF" StrokeThickness="1" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9">
                <TextBlock Foreground="#EDF9FF" FontSize="18" Text="Ready when you are." />
                <Canvas x:Name="OverlayWaveCanvas" Height="38" />
                <TextBlock Foreground="#71899E" FontSize="11" Text="Local visual prototype • no AI connected" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Background="#87111E2B" Padding="14,0">
            <TextBlock VerticalAlignment="Center" Foreground="#67DDEB" FontFamily="Consolas" FontSize="9" Text="MIC ON  •  PRIVACY LOCAL" />
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#5F788E" FontFamily="Consolas" FontSize="9" Text="ALWAYS ON TOP" />
        </Grid>
    </Grid>
</Window>

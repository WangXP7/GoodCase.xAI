<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Jarvis_VisualPrototype.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jarvis_VisualPrototype">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="JarvisAccentColor">#38E7FF</Color>
            <Color x:Key="JarvisBlueColor">#287CFF</Color>
            <Color x:Key="JarvisAmberColor">#FFB84A</Color>
            <SolidColorBrush x:Key="JarvisAccentBrush" Color="{StaticResource JarvisAccentColor}" />
            <SolidColorBrush x:Key="JarvisBlueBrush" Color="{StaticResource JarvisBlueColor}" />
            <SolidColorBrush x:Key="JarvisMutedBrush" Color="#7890A8" />
            <SolidColorBrush x:Key="JarvisTextBrush" Color="#E8F7FF" />
            <SolidColorBrush x:Key="JarvisPanelBrush" Color="#B30A1724" />
            <SolidColorBrush x:Key="JarvisBorderBrush" Color="#3438E7FF" />

            <Style x:Key="JarvisButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#191D5B72" />
                <Setter Property="Foreground" Value="{StaticResource JarvisTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource JarvisBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource JarvisButtonStyle}">
                <Setter Property="Width" Value="78" />
                <Setter Property="Height" Value="64" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="FontSize" Value="10" />
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource JarvisAccentBrush}" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="180" />
            </Style>

            <Style x:Key="ValueTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource JarvisTextBrush}" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
